NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Postgres Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/grandma_backend
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=grandma_backend

# Firebase Admin Credentials
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
# Or path to JSON: GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json

# Resend Email Service
RESEND_API_KEY=re_123456789_your_resend_api_key
EMAIL_FROM="Grandma's Launcher <noreply@yourdomain.com>"

# Caretaker PWA App URL (for magic links)
CARETAKER_WEB_URL=http://localhost:5173
