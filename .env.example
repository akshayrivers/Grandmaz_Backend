# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Postgres (DATABASE_URL wins over the PG* variables)
DATABASE_URL=
PGHOST=
PGPORT=
PGUSER=
PGPASSWORD=
PGDATABASE=

# Firebase Admin (service account fields, or GOOGLE_APPLICATION_CREDENTIALS=path to JSON)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# SMTP (Nodemailer). Leave SMTP_HOST empty in local dev to print magic links to the console.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Caretaker web app base URL used in invitation links (required in production).
# CARETAKER_WEB_URL is still read as a fallback for older setups.
APP_BASE_URL=

# Comma-separated browser origins allowed by CORS (the caretaker web app), e.g. http://localhost:5173
CORS_ORIGINS=

# Requests per minute per IP on public auth/pairing routes (default 20)
PUBLIC_RATE_LIMIT_PER_MINUTE=
