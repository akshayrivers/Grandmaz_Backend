# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Postgres (DATABASE_URL wins over the PG* variables)
DATABASE_URL=
PGHOST=
PGPORT=
PGUSER=
PGPASSWORD=
PGDATABASE=

# Firebase Admin (service account fields, or GOOGLE_APPLICATION_CREDENTIALS=path to JSON)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# Invitation email. Render's free instance blocks SMTP ports 25, 465, and 587.
# Brevo's relay also listens on 2525. Use the SMTP tab values, not an API key:
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=2525
#   SMTP_USER=<the Login on the SMTP tab>
#   SMTP_PASS=<the SMTP key>
# EMAIL_FROM must be exactly a sender marked Verified in Brevo. A 201 from the
# API still drops the mail when this address is not on that list.
# Leave BREVO_API_KEY empty unless it is an API key that starts with xkeysib-.
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Caretaker web app base URL used in invitation links (required in production).
# CARETAKER_WEB_URL is still read as a fallback for older setups.
APP_BASE_URL=

# Comma-separated browser origins allowed by CORS (the caretaker web app), e.g. http://localhost:5173
CORS_ORIGINS=

# Requests per minute per IP on public auth/pairing routes (default 20)
PUBLIC_RATE_LIMIT_PER_MINUTE=

# Directory for photo and voice-clip files (default data/media). Not an API key.
MEDIA_DIR=

# Optional Gemini key used only on the server. Leave empty to keep the assistant disabled.
# Never put this value in the Android app or the caretaker web bundle.
GEMINI_API_KEY=

